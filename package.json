{
  "name": "@oken/viem-account-hsm-gcp",
  "version": "0.0.0-semantic-release",
  "description": "Use a Google Cloud KMS key as a viem account signer.",
  "main": "dist/gcpHsmToAccount.js",
  "typings": "dist/gcpHsmToAccount.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oken-web3/viem-account-hsm-gcp.git"
  },
  "bugs": {
    "url": "https://github.com/oken-web3/viem-account-hsm-gcp/issues"
  },
  "homepage": "https://github.com/oken-web3/viem-account-hsm-gcp#readme",
  "author": "Oken",
  "contributors": [
    "Valora Inc"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "files": [
    "dist"
  ],
  "keywords": [
    "viem",
    "hsm",
    "evm",
    "blockchain",
    "signing",
    "cloud",
    "google cloud",
    "google kms"
  ],
  "scripts": {
    "build": "tsc",
    "build:scripts": "tsc --project scripts/tsconfig.json",
    "typecheck": "yarn build && yarn build:scripts",
    "lint": "eslint --ext=.tsx,.ts,.json src/ scripts/",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --log-level error --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit",
    "test:watch": "yarn test --watch",
    "test:ci": "yarn jest --ci --coverage --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "supercheck": "yarn format && yarn lint:fix && yarn typecheck && yarn knip && yarn test",
    "send": "ts-node ./scripts/send.ts",
    "knip": "knip",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "viem": "^2.9.20"
  },
  "dependencies": {
    "@aws-crypto/crc32c": "5.2.0",
    "@google-cloud/kms": "5.7.0",
    "@noble/curves": "1.9.7",
    "asn1js": "3.0.10"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/shelljs": "0.8.17",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-native": "4.1.0",
    "jest": "29.7.0",
    "knip": "6.3.0",
    "prettier": "3.8.3",
    "semantic-release": "25.0.1",
    "shelljs": "0.10.0",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "viem": "2.37.9"
  },
  "release": {
    "branches": [
      "main"
    ],
    "preset": "conventionalcommits"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "resolutions": {
    "@grpc/grpc-js": "1.14.4",
    "@tootallnate/once": "2.0.1",
    "form-data": "2.5.6",
    "jws": "4.0.1",
    "protobufjs": "7.6.5"
  }
}
